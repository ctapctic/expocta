# Configuración del Servidor Express
PORT=3000
NODE_ENV=development

# Configuración de Conexión a MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=expotecnia_eftp
DB_CONNECTION_LIMIT=10

# Directorio donde se escriben los archivos subidos.
# Los archivos se guardan en este disco Y se respaldan en la tabla `archivos` de MariaDB,
# así que sobreviven a reinicios del contenedor aunque el disco sea efímero.
UPLOADS_DIR=public/uploads

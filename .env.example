# Configuración del Servidor Express
PORT=3000
NODE_ENV=development

# Configuración de Conexión a MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=expotecnia_eftp
DB_CONNECTION_LIMIT=10

# Ruta base para almacenamiento de archivos subidos (relativa a public)
UPLOADS_DIR=public/uploads
